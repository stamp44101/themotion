{
  "name": "chiangmai-timelapse",
  "version": "1.0.0",
  "private": true,
  "description": "Motion-graphics hybrid timelapse of Chiang Mai history (9:16, Thai)",
  "scripts": {
    "studio": "remotion studio",
    "render": "remotion render ChiangMaiTimelapse out/chiangmai-timelapse.mp4 --audio-codec=aac --audio-bitrate=256k",
    "still": "remotion still ChiangMaiTimelapse out/still.png",
    "audio": "node scripts/export_timeline.mjs && python3 scripts/make_soundtrack.py",
    "render:iso": "remotion render ChiangMaiIso out/chiangmai-iso.mp4 --gl=angle --audio-codec=aac --audio-bitrate=256k"
  },
  "dependencies": {
    "@fontsource/kanit": "^5.1.0",
    "@react-three/fiber": "^8.17.10",
    "@remotion/cli": "^4.0.242",
    "@remotion/three": "^4.0.242",
    "@types/react": "^18.3.12",
    "@types/three": "^0.169.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "remotion": "^4.0.242",
    "three": "^0.169.0",
    "typescript": "^5.6.3"
  }
}
